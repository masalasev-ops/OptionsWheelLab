<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IncludeLabConfiguration>true</IncludeLabConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!--
    Both hosts are referenced, and carry real tests rather than existing to
    force a build. The side effect is that dotnet test now compiles them, so a
    broken host fails the suite rather than only the separate build step that
    CI runs.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/OptionsWheelLab.Core/OptionsWheelLab.Core.csproj" />
    <ProjectReference Include="../../src/OptionsWheelLab.Worker/OptionsWheelLab.Worker.csproj" />
    <ProjectReference Include="../../src/OptionsWheelLab.Api/OptionsWheelLab.Api.csproj" />
  </ItemGroup>

  <!--
    For HostConfigurationTests.The_web_host_resolves_the_same_store_path_as_the
    _generic_host, which needs WebApplication.CreateBuilder. The two host kinds
    default their content roots differently, which is the trap the shared
    configuration loader avoids, so the web path is worth exercising rather
    than assuming it matches the generic one.

    Revisit if the Api stops being a web host: this is a heavy reference on an
    otherwise framework-light test project and it exists for that one test.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
